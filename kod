import os
import time

RED = '\033[41m'
WHITE = '\033[47m'
BLUE = '\033[44m'
RESET = '\033[0m'

def flag():
    width = 30
    bands = [
        (RED, 2),
        (WHITE, 2),
        (BLUE, 4),
        (WHITE, 2),
        (RED, 2)
    ]
    for c, n in bands:
        for _ in range(n):
            print(c + ' ' * width + RESET)
flag() 
