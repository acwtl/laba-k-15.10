def sequence():
    with open('sequence.txt', 'r') as f:
        vals = [float(s.strip()) for s in f if s.strip()]
    cnt1 = sum(1 for v in vals if v > 5)
    cnt2 = sum(1 for v in vals if 0 < v < 5)
    total = cnt1 + cnt2
    if total == 0:
        print('Нет подходящих чисел')
        return
    print(RED + ' ' * int(cnt1 / total * 40) + RESET, f'{cnt1 / total * 100:.2f}%')
    print(BLUE + ' ' * int(cnt2 / total * 40) + RESET, f'{cnt2 / total * 100:.2f}%')
sequence()

